# ---- Canopus repository .gitignore ----

# Firmware images and analysis databases — NEVER commit these.
*.bin
# Watchface packager accepts only .lua/.bin; keep bundled watchface resources
# tracked. manager_loaded.bin is a legacy PNG payload; manager_icon.bin is the
# active LVGL v9 ARGB8888 icon bin (not a firmware image).
!watchfaces/canopus-installer/manager_loaded.bin
!watchfaces/canopus-installer/manager_icon.bin
*.img
*.i64
*.idb
*.id0
*.id1
*.id2
*.nam
*.til
*.so
*.dylib
*.a
firmware_latest/

# Rust build output
target/
**/target/
!manager/target/
!manager/target/**
Cargo.lock.bak

# C build output
build/
dist/
*.ko
*.o
*.obj
*.elf
*.axf
*.out
*.hex
*.map
*.lst
*.dSYM/
tests/host/canopus_host_tests

# Packaging output
*.canopus
*.canopus.sig
packages/
*.tar.gz
*.zip

# Python caches (host tooling helpers)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# macOS noise
.DS_Store
.AppleDouble
._*

# Editor / tooling
.vscode/
.idea/
*.swp
*.swo

# Claude Code local state (settings + ephemeral agent worktrees)
.claude/

# Local secrets / signing keys
*.pem
*.key
*.ed25519
keys/
secrets/

# Recovered artifacts that are too large or binary and belong outside VCS
captures/
dumps/
probes/bin/
